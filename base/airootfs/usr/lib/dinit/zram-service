#!/bin/sh
set -e

action="$1"

case "$action" in
    start)
        # Carrega modulo do kernel se necessario
        modprobe zram 2>/dev/null || true

        # Se zram0 ja for swap ativa, termina sem erro
        if grep -q "^/dev/zram0 " /proc/swaps 2>/dev/null; then
            exit 0
        fi

        # Define tamanho do ZRAM como 100% da RAM total
        ram_total_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
        zram_size_bytes=$(( ram_total_kb * 1024 ))

        # Inicializa o dispositivo zram
        # Tenta zramctl do util-linux
        if command -v zramctl >/dev/null 2>&1; then
            DEV=$(zramctl --find --size "${zram_size_bytes}" --algorithm zstd 2>/dev/null || \
                  zramctl --find --size "${zram_size_bytes}" 2>/dev/null || echo "/dev/zram0")
        else
            DEV="/dev/zram0"
            echo zstd > /sys/block/zram0/comp_algorithm 2>/dev/null || true
            echo "${zram_size_bytes}" > /sys/block/zram0/disksize 2>/dev/null || true
        fi

        # Formata e ativa como swap com prioridade maxima (32767)
        mkswap -f "$DEV" -L zram0 >/dev/null 2>&1
        swapon "$DEV" -p 32767
        ;;

    stop)
        if grep -q "^/dev/zram0 " /proc/swaps 2>/dev/null; then
            swapoff /dev/zram0 2>/dev/null || true
        fi
        if command -v zramctl >/dev/null 2>&1; then
            zramctl --reset /dev/zram0 2>/dev/null || true
        else
            echo 1 > /sys/block/zram0/reset 2>/dev/null || true
        fi
        ;;

    *)
        echo "Uso: $0 {start|stop}"
        exit 1
        ;;
esac
